{
  "manifest_version": 3,
  "name": "微文同步 · B站专栏",
  "version": "0.1.1",
  "description": "将微信公众号文章整理成可编辑的B站专栏草稿，转存图片并检查格式。不会自动发布。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting", "cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*", "https://*.qpic.cn/*", "https://*.qlogo.cn/*", "https://res.wx.qq.com/*",
    "https://api.bilibili.com/*", "https://member.bilibili.com/*", "https://www.bilibili.com/*",
    "https://*.hdslb.com/*", "https://*.biliimg.com/*"
  ],
  "action": { "default_title": "导入微信公众号文章" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{"matches":["https://member.bilibili.com/*"],"js":["vendor/html2canvas.min.js","native-ui.js"],"run_at":"document_idle"}],
  "web_accessible_resources": [{"resources":["lib/*.js"],"matches":["https://member.bilibili.com/*"]}],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
